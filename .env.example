# Copier en .env et remplir. Ne jamais committer .env.
# Sert à Docker Compose et au Secret Kubernetes (voir le README).
# Mots de passe : lettres et chiffres seulement (ils sont insérés tels quels dans du SQL et du shell).
MYSQL_ROOT_PASSWORD=
TOURNAMENT_DB_USER=tournament
TOURNAMENT_DB_PASSWORD=
USER_DB_USER=users
USER_DB_PASSWORD=
# 32 caractères minimum, par exemple :
# docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
